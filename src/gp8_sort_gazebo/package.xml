  <version>0.1.0</version>
  <description>Gazebo world and bringup for the Yaskawa GP8 sorting cell</description>
  <maintainer email="pai@example.com">pai</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gp8_sort_description</exec_depend>
  <exec_depend>gp8_sort_moveit_config</exec_depend>
