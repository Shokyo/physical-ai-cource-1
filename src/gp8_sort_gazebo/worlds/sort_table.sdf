<?xml version="1.0" ?>
<!--
  Sorting cell: table in front of the robot, three trays, three objects to be
  sorted and a fixed overhead RGB camera. The robot itself is spawned from the
  URDF by the launch file at the world origin.
-->
<sdf version="1.9">
  <world name="sort_table">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- GUI: 3D view only (no side panels), camera looking at the work cell -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.8 0.85 0.9</background_color>
        <camera_pose>1.40 -1.05 1.05 0 0.45 2.45</camera_pose>
        <camera_clip><near>0.05</near><far>50</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property></gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>
    </gui>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0.5 0 2.0 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <attenuation><range>10</range><constant>0.8</constant><linear>0.05</linear></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- work table: top surface at z = 0.15, x in [0.25, 0.75], y in [-0.35, 0.35] -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.7 0.15</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.7 0.15</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- trays (top surface at z = 0.10) -->
    <model name="tray_red">
      <static>true</static>
      <pose>0.30 0.50 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 0.16 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.16 0.16 0.10</size></box></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.6 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="tray_green">
      <static>true</static>
      <pose>0.30 -0.50 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 0.16 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.16 0.16 0.10</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="tray_blue">
      <static>true</static>
      <pose>0.05 0.50 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 0.16 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.16 0.16 0.10</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.3 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- objects to sort (link name must be "link": used by the DetachableJoint plugins) -->
    <model name="red_cube">
      <pose>0.45 0.15 0.176 0 0 0.3</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>4.2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="green_cube">
      <pose>0.60 -0.12 0.176 0 0 -0.4</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>4.2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.05 0.7 0.1 1</ambient><diffuse>0.05 0.7 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="blue_cylinder">
      <pose>0.55 0.04 0.181 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>4.6e-5</ixx><iyy>4.6e-5</iyy><izz>3.1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- fixed overhead camera looking straight down at the table -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.5 0 1.4 0 1.5708 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.06 0.06 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <topic>camera/image</topic>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image><width>800</width><height>600</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
    <!-- "cinematic" camera used to record the demo video off-screen
         (independent of what is on the user's screen) -->
    <model name="scene_camera">
      <static>true</static>
      <pose>2.05 -1.55 1.55 0 0.52 2.45</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <topic>scene_camera/image</topic>
          <update_rate>20</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>20</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
